{
  "name": "shattered-crown",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Shattered Crown: a physics-driven medieval open world in the browser",
  "scripts": {
    "dev": "vite --port 8941 --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8942",
    "assets": "node tools/fetch-assets.mjs",
    "test": "npm run build && node tests/e2e.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "shots": "node tests/shots.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "puppeteer": "^25.13.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
